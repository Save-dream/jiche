# 环境变量示例，复制为 .env 后填写

DJANGO_SECRET_KEY=jiche-dev-secret-key-change-in-production
DJANGO_DEBUG=false
# 生产环境务必写入公网 IP / 域名（逗号分隔，勿有空格问题）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,120.27.150.71

# sqlite（本地）或 mysql（生产推荐；Docker 部署固定 mysql）
DB_ENGINE=sqlite

# MySQL 配置（DB_ENGINE=mysql 时生效）
# 宿主机安装：bash deploy/switch-to-mysql.sh
# Docker：见 deploy/DOCKER.md 与根目录 .env.docker.example
DB_NAME=jiche
DB_USER=jiche
DB_PASSWORD=please_change_me
DB_HOST=127.0.0.1
DB_PORT=3306

# 微信配置 — 当前暂用账号密码登录，勿依赖微信扫码
WECHAT_MOCK=true
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=

# 前端站点来源（CORS）；生产填公网访问地址
CORS_ALLOWED_ORIGINS=http://120.27.150.71,http://localhost:5173

# 扫码票据有效期（秒）— 微信登录启用后再用
LOGIN_TICKET_EXPIRE_SECONDS=300

# 分享短链落地页域名（前端 Web 地址）
SHARE_WEB_BASE_URL=http://120.27.150.71
SHARE_SIGN_TTL_DAYS=7
