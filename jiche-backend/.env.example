# 环境变量示例，复制为 .env 后填写

DJANGO_SECRET_KEY=jiche-dev-secret-key-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite（本地快速开发）或 mysql（生产/联调）
DB_ENGINE=sqlite

# MySQL 配置（DB_ENGINE=mysql 时生效）
# DB_NAME=jiche
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# 微信配置 — 当前为占位假数据，系统完成后替换为真实凭证
# WECHAT_MOCK=true 时不会调用微信 API，仅占位存储
WECHAT_MOCK=true
WECHAT_MINI_APP_ID=wx_placeholder_mini_appid_00000001
WECHAT_MINI_APP_SECRET=placeholder_mini_secret_replace_before_production
WECHAT_WEB_APP_ID=wx_placeholder_web_appid_00000002
WECHAT_WEB_APP_SECRET=placeholder_web_secret_replace_before_production

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 扫码票据有效期（秒）
LOGIN_TICKET_EXPIRE_SECONDS=300

# 分享短链/签名落地页域名（前端 Web 地址）
SHARE_WEB_BASE_URL=http://localhost:5173
SHARE_SIGN_TTL_DAYS=7
