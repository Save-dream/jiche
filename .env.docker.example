# 复制为项目根目录 .env 后供 docker compose 使用：
#   cp .env.docker.example .env

HTTP_PORT=80
MYSQL_PUBLISH_PORT=127.0.0.1:3306

# 国内默认走 DaoCloud；若拉不动可改其它代理前缀
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

MYSQL_ROOT_PASSWORD=JicheRoot@2026
DB_NAME=jiche
DB_USER=jiche
DB_PASSWORD=JicheDb@2026

DJANGO_SECRET_KEY=请替换为随机长字符串
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=120.27.150.71,localhost,127.0.0.1

WECHAT_MOCK=true
CORS_ALLOWED_ORIGINS=http://120.27.150.71
SHARE_WEB_BASE_URL=http://120.27.150.71
SHARE_SIGN_TTL_DAYS=7
